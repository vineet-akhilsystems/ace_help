ACE_USERNAME=
ACE_PASSWORD=
ACE_BASE_URL=http://ace.akhilsystems.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
JEV_API_KEY=
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
# Legacy USERNAME, PASSWORD and BASE_URL in the existing .env are supported.
# Optional explicit selectors if ACE changes its login page:
ACE_USERNAME_SELECTOR=
ACE_PASSWORD_SELECTOR=
ACE_LOGIN_SELECTOR=
# Agent drafting (Draft with agent / ace-timesheet MCP server)
ACE_MCP_PATH=
AGENT_SCAN_ROOT=
AGENT_DEFAULT=antigravity
AGENT_TIMEOUT_SECONDS=180
AGENT_STARTUP_TIMEOUT_SECONDS=60
AGENT_IDLE_TIMEOUT_SECONDS=90
